# Copy this file to .env in backend_cyberia/.
# Generate your own SECRET_KEY before running Django; do not commit .env.
SECRET_KEY=replace-with-your-own-random-secret-key

# Keep the local defaults below while testing with Docker. For a public HTTPS
# deployment, replace example.com with the real domain and enable the secure
# cookie/redirect options only after TLS and the reverse proxy are working.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional: TMDB API Read Access Token (Bearer token), not the API key.
# Leave empty to run without TMDB search and automatic movie/series details.
TMDB_ACCESS_TOKEN=
