patch {
  url: {{baseUrl}}/api/v1/movies/{{movieId}}/
  body: json
  auth: none
}

headers {
  X-CSRFToken: {{csrfToken}}
}

body:json {
  {
    "status": "WG",
    "current_minute": 20
  }
}

tests {
  test("updates the movie", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
